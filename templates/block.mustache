<div id="block-completion-monitor-{{uniqid}}" class="block-completion-monitor">
    <div class="completion_monitor-custom-header">
        <div class="main-content">
            <h2 class="block_title">
                {{#str}} blocktitle, block_completion_monitor {{/str}}
            </h2>

            {{#display_percentage}}
                <div class="block-progress-informations">
                    {{> block_completion_monitor/progress_header/progress_circle }}
                    {{> block_completion_monitor/progress_header/course_progress_details }}
                </div>
            {{/display_percentage}}
        </div>

        <div class="open-block">

                {{> block_completion_monitor/progress_header/show_more_button }}

        </div>
    </div>

    <div class="completion_monitor-content hidden-block">
        {{> block_completion_monitor/progress_bar/progress_bar }}
        {{#can_access_report}}
        <div class="completion_monitor-moodle-footer">
            <div class ="completion_monitor-link">
                <a href="{{reporturl}}" class="fr-fi-arrow-right-line">{{#str}} viewreport, block_completion_monitor {{/str}}</a>
            </div>
        </div>
        {{/can_access_report}}
    </div>   
</div>
